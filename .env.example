# Groq API key, used only for the LLM structured-classification fallback
# (deterministic regex routing handles the majority of questions without it).
# Free tier is sufficient. Get one at https://console.groq.com.
GROQ_API_KEY=

# Comma-separated list of allowed CORS origins for the /query, /report, and
# /compare endpoints. Defaults to "*" (any origin) if unset — fine for local
# development, but should be set to your actual frontend origin(s) in any
# deployed environment.
# ALLOWED_ORIGINS=https://your-deployed-frontend.example.com
